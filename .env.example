# Repo-root env file for `docker compose up` (see ../docker-compose.yml).
# Copy to `.env` in this same folder and fill in real values — docker
# compose auto-loads it both for ${VAR} substitution in the compose file
# (the postgres service's POSTGRES_* vars) and, via `env_file:`, as the
# api container's runtime environment.
#
# Running fratoo-bridge directly without Docker instead? Use
# fratoo-bridge/.env.example there — that path is unaffected by this file.

# ── Postgres ────────────────────────────────────────────────────────────
DB_USERNAME=fratoo
DB_PASSWORD=change-me
DB_NAME=fratoo
# DB_HOST is NOT set here — docker-compose.yml hardcodes it to the
# "postgres" service name for the api container. Only relevant if you run
# the bridge outside Docker (see fratoo-bridge/.env.example).

# ── Auth (single-admin login for the standalone dashboard) ────────────────
# Generate the hash with: cd fratoo-bridge && npm run hash-password -- "your-password-here"
# Never put the plaintext password itself in this file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$replace-with-output-of-hash-password-script
JWT_SECRET=change-me-to-a-long-random-string

# ── Push notifications (OPTIONAL) ─────────────────────────────────────────
# The VAPID keys are generated on first start and kept in the database, so
# nothing is required here. Push services want a contact (mailto: or https:)
# in every message; it defaults to the project's GitHub URL.
# PUSH_SUBJECT=mailto:you@example.com
