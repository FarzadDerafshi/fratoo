# Running via `docker compose up` from the repo root? Use ../.env.example
# instead — this file is for running fratoo-bridge directly (npm run
# start:dev), outside Docker.

# ── Postgres (primary datastore as of the standalone-backend migration) ───
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fratoo
DB_PASSWORD=change-me
DB_NAME=fratoo

# ── Auth (single-admin login for the standalone dashboard) ────────────────
# Generate the hash with: npm run hash-password -- "your-password-here"
# Never put the plaintext password itself in this file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$12$replace-with-output-of-hash-password-script
JWT_SECRET=change-me-to-a-long-random-string

# ── Push notifications (OPTIONAL) ─────────────────────────────────────────
# The VAPID keys are generated on first start and kept in the database, so
# nothing is required here. Push services want a contact (mailto: or https:)
# in every message; it defaults to the project's GitHub URL.
# PUSH_SUBJECT=mailto:you@example.com
